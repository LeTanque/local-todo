{
  "name": "todo-electron",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"npm run electron:dev\"",
    "next:dev": "next dev",
    "electron:dev": "wait-on http://127.0.0.1:3000 && electron .",
    "dist": "npm run build && electron-builder",
    "build": "next build && node scripts/copy-next-assets.cjs",
    "start": "next start",
    "lint": "eslint"
  },
  "build": {
    "appId": "com.cyberpunk2044todo.app",
    "files": [
      "electron/main.cjs",
      ".next/standalone/**/*"
    ],
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "electron-serve": "^3.0.1",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "sass": "^1.101.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
