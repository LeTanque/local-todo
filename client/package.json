{
  "name": "client",
  "productName": "cyberpunk2077-todo",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron .",
    "next:dev": "next dev -p 4310",
    "electron:dev": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dist": "npm run build && npm run bundle:api && electron-builder",
    "bundle:api": "node scripts/bundle-api.cjs",
    "build": "next build && node scripts/copy-next-assets.cjs",
    "start": "next start -p 4310",
    "lint": "eslint"
  },
  "build": {
    "appId": "com.cyberpunk2077todo.app",
    "electronVersion": "43.4.1",
    "files": [
      "electron/main.cjs",
      ".next/standalone/**/*"
    ],
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/api.cjs",
        "to": "api.cjs"
      },
      {
        "from": "resources/api.env",
        "to": "api.env"
      }
    ],
    "mac": {
      "target": ["dir"]
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "electron-serve": "^3.0.1",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "sass": "^1.101.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
